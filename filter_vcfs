SCAF=$1

gatk --java-options "-Xmx4g" VariantFiltration \
-R /home/centos/USS/lemurs/RefGenomes/Varecia_rubra.fa \
-V ${SCAF}.vcf.gz -O ${SCAF}.filttag.vcf.gz \
--filter-expression "QD < 5.0" --filter-name QD5 \
--filter-expression "FS > 60.0" --filter-name FS60 \
--filter-expression "SOR > 3.0" --filter-name SOR3 \
--filter-expression "MQ < 40.0" --filter-name MQ40 \
--filter-expression "MQRankSum < -5.0" --filter-name MQRS-5 \
--filter-expression "MQRankSum > 5.0" --filter-name MQRS5 \
--filter-expression "ReadPosRankSum < -3.0" --filter-name RPRS-3 \
--filter-expression "ReadPosRankSum > 3.0" --filter-name RPRS3 \
--filter-expression "AN < 160" --filter-name AN160 \
--filter-expression "DP > 8822" --filter-name DP8822 \
--filter-expression "DP < 890" --filter-name DP890 \
--verbosity ERROR
}

export -f gatk_filt

parallel -j 20 --tmpdir tmp gatk_filt \
:::: <(awk '{print $1}' /home/centos/USS/lemurs/RefGenomes/Varecia_rubra.fa.fai) >& gatk_filt.out


