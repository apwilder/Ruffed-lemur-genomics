cd ~/USS/lemurs/GATK

awk '$4=="Varu" && $2=="Wild" {print $1}' ../SampleLists/AllVarecia_sampletable.txt > ../SampleLists/Varu_Wild_samples.txt
awk '$4=="Varu" {print $1}' ../SampleLists/AllVarecia_sampletable.txt > ../SampleLists/Varu_samples.txt

####pull out only SUPER scaffolds######
nohup bcftools view AllVarecia.filtsnps.vcf.gz --regions SUPER_1,SUPER_2,SUPER_3,SUPER_4,SUPER_5,SUPER_6,\
SUPER_7,SUPER_8,SUPER_9,SUPER_10,SUPER_11,SUPER_12,SUPER_13,SUPER_14,SUPER_15,SUPER_16,SUPER_17,\
SUPER_18,SUPER_19,SUPER_20,SUPER_21,SUPER_22 -o AllVarecia_SUPERautoz.filtsnps.vcf.gz -O z --threads 8 &

##make plink from all Varecia
nohup plink --recode --allow-extra-chr \
--vcf AllVarecia_SUPERautoz.filtsnps.vcf.gz --out ~/USS/lemurs/plink/AllVarecia_SUPERautoz \
--double-id --snps-only --threads 8 &

cd  ~/USS/lemurs/plink/

##Varu
nohup plink --keep <(paste ../SampleLists/Varu_Wild_samples.txt ../SampleLists/Varu_Wild_samples.txt) --maf 0.05 \
--recode --allow-extra-chr \
--file AllVarecia_SUPERautoz --out WildVaru_SUPERautoz --double-id --threads 8 &

nohup plink --keep <(paste ../SampleLists/Varu_samples.txt ../SampleLists/Varu_samples.txt) --maf 0.05 \
--recode --allow-extra-chr \
--file AllVarecia_SUPERautoz --out Varu_SUPERautoz --double-id --threads 8 &

##Vava
nohup plink --keep <(awk '{print $1"\t"$1}' ../SampleLists/Vava_localities.txt) \
--recode --allow-extra-chr --maf 0.05 \
--file AllVarecia_SUPERautoz --out WildVava_SUPERautoz --double-id --threads 8 &

####PCA and heterozygosity (het is different when estimated w/in vs across species)###
nohup plink --pca --het --file AllVarecia_SUPERautoz \
--out AllVarecia_SUPERautoz --allow-extra-chr &

nohup plink --pca --het --file WildVaru_SUPERautoz \
--out WildVaru_SUPERautoz --allow-extra-chr &

nohup plink --pca --het --file Varu_SUPERautoz \
--out Varu_SUPERautoz --allow-extra-chr &

####KING relatedness
SAMPLES=/home/centos/USS/lemurs/SampleLists/Varu_Andranobe_2019.txt
plink2 --make-king-table --pedmap Varecia_Wild.filtsnps --allow-extra-chr \
--out Varu_Andranobe_2019_SUPERautoz --geno 0 --king-cutoff 0.2 \
--keep <(awk '{print $1"\t"$1}' ${SAMPLES}) --maf 0.05


nohup plink --pca --het --file WildVava_SUPERautoz \
--out WildVava_SUPERautoz --allow-extra-chr &
